# MongoDB connection string. Local dev falls back to mongodb://localhost:27017/youtube-app if unset.
MONGO_URI=

# Random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin allowed to call this API (CORS). The deployed frontend's URL in production.
FRONTEND_URL=http://localhost:5173

# Cloudinary credentials, from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
